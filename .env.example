# Environment Configuration
# NODE_ENV="development" # Default set by vite, Options: development, test, production

# Server Configuration
BASE_URL="http://localhost:5173" # Must be set to the production domain (e.g., https://tracktor.example.com)

# Database Configuration, optional - by default, app handles it
# DB_PATH="./tracktor.db"

# File Upload Configuration, optional - by default, app handles it
# UPLOADS_DIR="./uploads"
# BODY_SIZE_LIMIT=10M # Default: Infinity

# CORS Configuration
# CORS_ORIGINS="*" # Default: "*"

# Logging Configuration, optional - by default, app handles it
# LOG_REQUESTS=true
# LOG_LEVEL="info"
# LOG_DIR="./logs"

# Security Configuration
# APP_SECRET="" # Secret key for encrypting sensitive data (generate with: openssl rand -hex 32)
SUPERADMIN_EMAILS=""         # Comma-separated list of emails that auto-approve on registration
SUPERADMIN_USERNAMES=""      # Comma-separated list of usernames that are superadmins

# OAuth Configuration, only needed if Google OAuth login active
GOOGLE_CLIENT_ID=""     # Google OAuth client ID
GOOGLE_CLIENT_SECRET="" # Google OAuth client secret

# Application Features
# TRACKTOR_DEMO_MODE=false              # Default: false
# FORCE_DATA_SEED=false                 # Default: false
# TRACKTOR_DISABLE_AUTH=false           # Default: false
# TRACKTOR_DISABLE_PASSWORD_LOGIN=false # Default: false, disable password-based login, require Google OAuth
# TRACKTOR_DISABLE_GOOGLE_LOGIN=false   # Default: false, disable Google OAuth login
